# --- MAX ---------------------------------------------------------------
# Токен бота: business.max.ru → Чат-боты → ⋮ → Настройки
MAX_BOT_TOKEN=
# Каталог с сертификатами Минцифры (по умолчанию ./ca в корне проекта)
# CA_DIR=
# polling — локальная разработка (публичный адрес не нужен); webhook — продакшен
MAX_MODE=polling
# Для MAX_MODE=webhook:
# MAX_WEBHOOK_DOMAIN=https://bot.example.com
# MAX_WEBHOOK_PORT=3001
# MAX_WEBHOOK_PATH=/max/webhook
# MAX_WEBHOOK_SECRET=change-me

# --- Бот -----------------------------------------------------------------
# HTTP-сервер бота: приём уведомлений об оплате (POST /payments/webhook)
BOT_HTTP_PORT=3000
# Ссылка на политику обработки персональных данных (показывается при запросе телефона)
POLICY_URL=https://example.com/privacy
# Как часто менять текст «живого» прогресса (MAX: ≤2 правки/сек на диалог)
PROGRESS_INTERVAL_MS=2000
PRICING_POLL_MS=2000
SCORING_TIMEOUT_MS=600000
# Кнопки «🧪 Оплата успешна / Отказ банка» в чате — только для mock-эквайера (0 — выключить)
PAYMENT_SHORTCUTS=1

# --- Mock-сервисы ----------------------------------------------------------
MOCKS_PORT=4000
MOCKS_BASE_URL=http://localhost:4000
# Адрес страницы оплаты, который увидит пользователь. Для теста с телефона — туннель (ngrok, cloudflared)
MOCKS_PUBLIC_URL=http://localhost:4000
PAYMENT_WEBHOOK_URL=http://localhost:3000/payments/webhook
PAYMENT_WEBHOOK_SECRET=mock-secret
# Задержки, имитирующие реальные сервисы
MOCK_LOOKUP_DELAY_MS=800
MOCK_ENRICH_DELAY_MS=3000
MOCK_PRICING_DELAY_MS=15000
# «Долгий» скоринг для VIN, оканчивающихся на 88888 — проверить уведомление, когда пользователь ушёл
MOCK_PRICING_SLOW_MS=90000
